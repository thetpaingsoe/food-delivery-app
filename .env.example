# Database URLs (Neon Postgres)
AUTH_DATABASE_URL=postgresql://user:password@host/auth_db?sslmode=require
ITEM_DATABASE_URL=postgresql://user:password@host/item_db?sslmode=require
ORDERS_DATABASE_URL=postgresql://user:password@host/orders_db?sslmode=require
KITCHEN_DATABASE_URL=postgresql://user:password@host/kitchen_db?sslmode=require
RIDER_DATABASE_URL=postgresql://user:password@host/rider_db?sslmode=require

# Auth
JWT_SECRET=your-random-secret-here
JWT_EXPIRES_IN=7d
